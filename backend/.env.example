# ============================================================================
# STUDENT COMMUNITY TRACKING SYSTEM (SCTS) - BACKEND ENVIRONMENT VARIABLES
# ============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL / H2)
DB_URL=jdbc:h2:mem:sctsdb;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=password

# JWT Security Key (Must be at least 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_change_in_production_environment_32chars
JWT_EXPIRATION_MS=86400000

# Google OAuth Credentials (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# File Upload Directory
FILE_UPLOAD_DIR=uploads/certificates

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
